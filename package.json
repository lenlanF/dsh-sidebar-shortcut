{
  "name": "dsh-sidebar-shortcut",
  "version": "0.7.2",
  "description": "DSH client plugin: create customizable, collapsible left-sidebar shortcut groups for installed plugins and existing sidebar entries.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lenlanF/dsh-sidebar-shortcut.git"
  },
  "author": "lenlanF <1154688571@qq.com>",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": "^0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "sidebar",
    "shortcut",
    "plugin-navigation"
  ]
}
